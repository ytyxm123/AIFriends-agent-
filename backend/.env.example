API_KEY=replace-with-your-api-key
API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=deepseek-v4-flash-0731

WSS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
VOICE_URL=https://dashscope.aliyuncs.com/api/v1/services/audio/tts/customization
ENABLE_TTS=false
TTS_MODEL=cosyvoice-v3-flash

MEMORY_MODEL=qwen-plus
MEMORY_EMBEDDING_MODEL=text-embedding-v4
MEMORY_EMBEDDING_DIMENSIONS=1024
MEMORY_USE_EMBEDDINGS=true

DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

AGENT_MAX_TOOL_ROUNDS=4
AGENT_MAX_REPEAT_CALLS=2
KNOWLEDGE_SOURCE_PATH=./web/documents/data.txt
KNOWLEDGE_TABLE_NAME=my_knowledge_base
